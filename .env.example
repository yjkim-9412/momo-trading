DATABASE_URL=sqlite:///./data/app.db      # 애플리케이션 DB 연결 문자열
APP_NAME=momo-trading                     # 서비스 이름
APP_VERSION=0.1.0                         # 서비스 버전 표기
ENVIRONMENT=local                         # 실행 환경: local/staging/production
LOG_LEVEL=DEBUG                           # 로그 출력 레벨
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]  # 허용할 프론트엔드 Origin 목록

# === KIS MCP 서버 ===
KIS_MCP_URL=http://localhost:3100/sse     # KIS MCP SSE 서버 주소

# KIS API 인증 (MCP Docker에 전달)
KIS_APP_KEY=                              # 실전 투자용 KIS 앱 키
KIS_APP_SECRET=                           # 실전 투자용 KIS 앱 시크릿
KIS_PAPER_APP_KEY=                        # 모의 투자용 KIS 앱 키
KIS_PAPER_APP_SECRET=                     # 모의 투자용 KIS 앱 시크릿
KIS_ACCT_STOCK=                           # 실전 계좌번호(권장: 10자리 전체 / 호환: CANO 8자리)
KIS_PAPER_STOCK=                          # 모의 투자 계좌번호(권장: 10자리 전체 / 호환: CANO 8자리)
KIS_PROD_TYPE=                            # 상품코드 2자리 override (8자리 CANO만 입력하면 필수)
KIS_ACCOUNT_TYPE=VIRTUAL                  # 계좌 타입: VIRTUAL 또는 REAL

# KIS WebSocket
KIS_WS_URL_DOMESTIC=ws://ops.koreainvestment.com:21000  # 국내장 실시간 WebSocket 주소
KIS_WS_URL_OVERSEAS=ws://ops.koreainvestment.com:31000  # 해외장 실시간 WebSocket 주소

# === Multi-market Runtime ===
ENABLED_MARKETS=KRX                       # 런타임에서 활성화할 시장 목록 (동시 운영: KRX,US)
PRIMARY_MARKET=KRX                        # 스케줄러와 기본 조회에 사용할 대표 시장
US_SCAN_MARKETS=NASDAQ,NYSE,AMEX         # 미국장 스캔 대상 거래소 목록
US_TRADING_ENABLED=false                  # 미국장 거래 기능 활성화 여부
US_PREMARKET_ENABLED=f
alse                # 미국 프리마켓(04:00~09:30 ET) 거래 허용 여부
US_AFTERMARKET_ENABLED=false              # 미국 애프터마켓(16:00~20:00 ET) 거래 허용 여부
US_WATCHLIST_SYMBOLS=AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA,AMD  # 미국장 기본 감시 종목 목록
US_SCAN_LIMIT=12                          # 미국장 스캔 시 최대 후보 종목 수
BASE_CURRENCY=KRW                         # 손익/리스크 계산 기준 통화
FX_RATE_SOURCE=KIS                        # 환율 조회 소스
US_LEVERAGED_PRODUCTS_ENABLED=true        # 미국 레버리지 ETF 제한 허용 여부
US_INVERSE_PRODUCTS_ENABLED=true          # 미국 인버스 ETF 제한 허용 여부
US_LEVERAGE_ALLOWED_SESSIONS=US_REGULAR   # 제한 상품 허용 세션 목록
US_LEVERAGE_ALLOWED_STRATEGIES=STABLE_SHORT  # 제한 상품 허용 전략 목록
US_LEVERAGE_MAX_SINGLE_ORDER_RATIO=0.3    # 제한 상품 1회 주문 한도 비율
US_LEVERAGE_ALLOWLIST=                    # 제한 상품으로 강제 분류/허용할 티커 목록
US_LEVERAGE_DENYLIST=                     # 제한 상품 중 강제 차단할 티커 목록
US_LEVERAGE_KEYWORDS=2X,3X,ULTRA,ULTRAPRO,LEVERAGED  # 레버리지 상품명 판별 키워드
US_INVERSE_KEYWORDS=INVERSE,SHORT,BEAR    # 인버스 상품명 판별 키워드
US_BUY_CUTOFF_HOUR=15                     # 미국장 매수 마감 시각 (ET 기준 시)
US_BUY_CUTOFF_MINUTE=30                   # 미국장 매수 마감 시각 (ET 기준 분)
US_FORCE_LIQUIDATION_HOUR=15              # 미국장 강제 청산 시각 (ET 기준 시)
US_FORCE_LIQUIDATION_MINUTE=40            # 미국장 강제 청산 시각 (ET 기준 분)
#
# 미국장 프리마켓 예시 (복사해서 사용)
# ENABLED_MARKETS=NASDAQ,NYSE,AMEX        # 미국장만 활성화
# PRIMARY_MARKET=NASDAQ                   # 대표 시장을 나스닥으로 설정
# US_TRADING_ENABLED=true                 # 미국장 거래 기능 활성화
# US_PREMARKET_ENABLED=true               # 프리마켓 거래 허용
# US_AFTERMARKET_ENABLED=false            # 애프터마켓은 비활성 유지
#
# 참고:
# - US_PREMARKET_ENABLED=true 이면 미국 프리마켓(04:00~09:30 ET)을 장중 세션으로 인식합니다.
# - 현재 스케줄러 기본 시각은 정규장 직전/직후 기준입니다.
# - 레버리지/인버스 ETF는 기본적으로 미국 정규장 + STABLE_SHORT 전략만 허용하도록 설계되었습니다.

# === AI / LLM ===
LLM_PROVIDER=CLAUDE_CODE              # CLAUDE_CODE 또는 CODEX_CLI

# Claude Code CLI
CLAUDE_CODE_MODEL=sonnet              # Claude 기본 모델
CLAUDE_CODE_MODEL_TIER1=haiku         # Tier1 스캔/분석용 모델
CLAUDE_CODE_MODEL_TIER2=sonnet        # Tier2 최종 검토용 모델
# CLAUDE_CODE_PATH=/opt/homebrew/bin/claude  # 비어있으면 자동 탐색

# Codex CLI
CODEX_MODEL=gpt-5.4                   # Codex 기본 모델
CODEX_MODEL_TIER1=                    # Tier1 전용 모델, 비우면 CODEX_MODEL 사용
CODEX_MODEL_TIER2=                    # Tier2 전용 모델, 비우면 CODEX_MODEL 사용
CODEX_REASONING_EFFORT=               # Codex 추론 강도 기본값
CODEX_REASONING_EFFORT_TIER1=         # Tier1 공통 추론 강도, 비우면 profile/global/default 순으로 해석
CODEX_REASONING_EFFORT_TIER1_SCAN=    # Tier1 스캔 프로필, 비우면 TIER1 → global → low
CODEX_REASONING_EFFORT_TIER1_ANALYSIS=  # Tier1 종목판단 프로필, 비우면 TIER1 → global → medium
CODEX_REASONING_EFFORT_TIER2=xhigh    # Tier2 추론 강도
# CODEX_CLI_PATH=/opt/homebrew/bin/codex

# === AI Agent ===
AUTONOMY_MODE=SEMI_AUTO               # SEMI_AUTO 또는 AUTONOMOUS
RECOMMENDATION_EXPIRE_MIN=60          # 추천 유효 시간(분)
MIN_BUY_QUANTITY=1                    # 최소 주문 수량

# === Trading Safety ===
TRADING_ENABLED=false                 # 실제 주문 실행 허용 여부
DAY_TRADING_ONLY=false                # true=당일 청산 필수, false=스윙 보유 허용
MAX_HOLD_DAYS_STABLE=5                # STABLE_SHORT 최대 보유일
MAX_HOLD_DAYS_AGGRESSIVE=3            # AGGRESSIVE_SHORT 최대 보유일
MAX_DAILY_TRADES=30                   # 하루 최대 주문 횟수
# MAX_SINGLE_ORDER_KRW=5000000        # 1회 주문 금액 상한, 비우면 AI 자율 결정

# === AI Risk Tuning ===
AI_RISK_TUNING_ENABLED=true           # AI 기반 리스크 튜닝 활성화 여부
RISK_APPETITE=MODERATE                # 위험 성향: CONSERVATIVE/MODERATE/AGGRESSIVE
MIN_CASH_RATIO=0.05                   # 최소 현금 비중 (0.05 = 5%)

# === Scheduler ===
SCHEDULER_ENABLED=true                # APScheduler 실행 여부
