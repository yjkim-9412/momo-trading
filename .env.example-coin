# ============================================================
#  MOMO Trading — 코인 (Bithumb) 환경변수 예제
#  주식(KIS) 설정과 완전 독립. 기존 .env에 아래 항목을 추가하세요.
# ============================================================

# === Bithumb API 인증 ===
BITHUMB_API_KEY=                              # 빗썸 Open API 키
BITHUMB_API_SECRET=                           # 빗썸 Open API 시크릿
BITHUMB_WS_URL_PUBLIC=wss://ws-api.bithumb.com/websocket/v1
BITHUMB_WS_URL_PRIVATE=wss://ws-api.bithumb.com/websocket/v1/private

# === Crypto 운영 (주식 TRADING_ENABLED, AUTONOMY_MODE 등과 독립) ===
CRYPTO_ENABLED=false                          # 코인 기능 전체 활성화 여부
CRYPTO_PRIMARY_MARKET=BITHUMB                 # 코인 기본 시장 코드, 비우면 BITHUMB 고정
CRYPTO_TRADING_ENABLED=false                  # 실제 주문 실행 허용 여부 (false=분석만)
CRYPTO_AUTONOMY_MODE=SEMI_AUTO                # SEMI_AUTO: 추천→승인 / AUTONOMOUS: 자동 체결
CRYPTO_TRADING_STYLE_MODE=CONSERVATIVE        # CONSERVATIVE: 현재 기준 유지 / AGGRESSIVE: 강세장 진입 기준 완화
CRYPTO_RECOMMENDATION_EXPIRE_MIN=30           # 추천 유효 시간(분), 코인은 빠르므로 짧게
CRYPTO_TIMEBOX_HOURS=12                       # 포지션 최대 보유시간 (12 또는 24, admin-coin 변경 시 .env에도 반영)

# === Crypto 스캔 ===
CRYPTO_SCAN_INTERVAL_HOURS=4                  # 시장 스캔 주기 (시간), 24/7 고정 간격
CRYPTO_HOLDINGS_CHECK_INTERVAL_HOURS=2        # 보유 코인 점검 주기 (시간)
CRYPTO_WATCHLIST_SYMBOLS=BTC,ETH,XRP,SOL,ADA,DOGE  # 기본 감시 코인 목록
CRYPTO_SCAN_LIMIT=15                          # 스캔 시 최대 후보 코인 수
CRYPTO_DYNAMIC_DISCOVERY_ENABLED=true         # broad discovery universe + watchlist 시드 병합
CRYPTO_DISCOVERY_REFRESH_MINUTES=360          # 전체 KRW 마켓 universe 새로고침 주기(분)
CRYPTO_DISCOVERY_UNIVERSE_SIZE=30             # broad refresh 후 유지할 상위 유동성 코인 수

# === Crypto 리스크 (주식 리스크 설정과 독립) ===
CRYPTO_MAX_POSITION_PCT=20.0                  # 코인당 최대 포트폴리오 비중 (%)
CRYPTO_MIN_CASH_RATIO=0.10                    # 최소 현금 비중 (0.10 = 10%, 주식 5%보다 높게)
CRYPTO_MAX_SINGLE_ORDER_KRW=0                 # 1회 주문 금액 상한, 0=AI 자율 결정
CRYPTO_MAX_DAILY_TRADES=0                     # 하루 최대 주문 횟수, 0=무제한
CRYPTO_MIN_BUY_QUANTITY=0.0                   # 최소 매수 수량 (소수점 가능, 예: 0.001)

# === Crypto LLM (비어있으면 주식 LLM 설정을 그대로 사용) ===
CRYPTO_LLM_PROVIDER=                          # CLAUDE_CODE / CODEX_CLI, 비어있으면 LLM_PROVIDER 사용
#
# Claude Code 설정 (CRYPTO_LLM_PROVIDER=CLAUDE_CODE일 때)
CRYPTO_LLM_MODEL_TIER1_SCAN=                  # 코인 스캔용 모델 (예: haiku)
CRYPTO_LLM_MODEL_TIER1_ANALYSIS=              # 코인 분석용 모델 (예: haiku)
CRYPTO_LLM_MODEL_TIER2=                       # 코인 최종검토 모델 (예: sonnet)
CRYPTO_CLAUDE_EFFORT_TIER1_SCAN=              # 스캔 추론 강도 (예: low, 비어있으면 medium)
CRYPTO_CLAUDE_EFFORT_TIER1_ANALYSIS=          # 분석 추론 강도 (예: medium, 비어있으면 medium)
CRYPTO_CLAUDE_EFFORT_TIER2=                   # 최종검토 추론 강도 (예: high, 비어있으면 high)
CRYPTO_CLAUDE_EFFORT_REPORT=                  # 체크포인트 리포트 effort (예: max, 비우면 high)
#
# Codex CLI 설정 (CRYPTO_LLM_PROVIDER=CODEX_CLI일 때)
CRYPTO_CODEX_MODEL=                           # 코인 전용 Codex 모델, 비어있으면 CODEX_MODEL 사용
CRYPTO_CODEX_REASONING_EFFORT_REPORT=         # 체크포인트 리포트 추론 강도 (비우면 xhigh)
CRYPTO_CODEX_REASONING_EFFORT_TIER1_SCAN=     # 스캔 추론 강도 (예: low)
CRYPTO_CODEX_REASONING_EFFORT_TIER1_ANALYSIS= # 분석 추론 강도 (예: medium)
CRYPTO_CODEX_REASONING_EFFORT_TIER2=          # 최종검토 추론 강도 (예: xhigh)

# ============================================================
#  프로필 예시
# ============================================================
#
# === 보수적 코인 투자 프로필 (복사해서 사용) ===
# BTC, ETH 대형 코인 위주, 반자율 모드
#
# CRYPTO_ENABLED=true
# CRYPTO_TRADING_ENABLED=true
# CRYPTO_AUTONOMY_MODE=SEMI_AUTO
# CRYPTO_TRADING_STYLE_MODE=CONSERVATIVE
# CRYPTO_TIMEBOX_HOURS=24
# CRYPTO_WATCHLIST_SYMBOLS=BTC,ETH,XRP,SOL
# CRYPTO_SCAN_LIMIT=8
# CRYPTO_SCAN_INTERVAL_HOURS=6
# CRYPTO_MAX_POSITION_PCT=25.0
# CRYPTO_MIN_CASH_RATIO=0.15
# CRYPTO_MAX_DAILY_TRADES=5
#
# 참고:
# - SEMI_AUTO: /admin-coin 페이지에서 AI 추천을 확인 후 승인/거절
# - 대형 코인 위주이므로 스캔 간격을 6시간으로 넉넉하게 설정
# - 최소 현금 15% 유지로 급변 시 대응 여력 확보
#
# === 적극적 코인 투자 프로필 (복사해서 사용) ===
# 알트코인 포함, 자율 모드, 짧은 스캔 주기
#
# CRYPTO_ENABLED=true
# CRYPTO_TRADING_ENABLED=true
# CRYPTO_AUTONOMY_MODE=AUTONOMOUS
# CRYPTO_TRADING_STYLE_MODE=AGGRESSIVE
# CRYPTO_TIMEBOX_HOURS=12
# CRYPTO_WATCHLIST_SYMBOLS=BTC,ETH,XRP,SOL,ADA,DOGE,AVAX,DOT,LINK,MATIC
# CRYPTO_SCAN_LIMIT=20
# CRYPTO_SCAN_INTERVAL_HOURS=2
# CRYPTO_HOLDINGS_CHECK_INTERVAL_HOURS=1
# CRYPTO_MAX_POSITION_PCT=15.0
# CRYPTO_MIN_CASH_RATIO=0.10
# CRYPTO_MAX_DAILY_TRADES=20
# CRYPTO_RECOMMENDATION_EXPIRE_MIN=15
#
# 참고:
# - AUTONOMOUS: AI가 분석→매매까지 자동 실행
# - 알트코인 변동성이 높으므로 코인당 최대 비중을 15%로 제한
# - 2시간 스캔 주기 + 1시간 보유 점검으로 촘촘하게 모니터링
# - 안정화 전까지는 SEMI_AUTO로 먼저 테스트 권장





# === 5만원 초저자본 테스트 프로필 (복사해서 사용) ===
# 시스템 검증 전용. API 연동·주문·취소 동작 확인 목적.
#
# CRYPTO_ENABLED=true
# CRYPTO_TRADING_ENABLED=true
# CRYPTO_AUTONOMY_MODE=SEMI_AUTO
# CRYPTO_TRADING_STYLE_MODE=CONSERVATIVE
# CRYPTO_TIMEBOX_HOURS=12
# CRYPTO_WATCHLIST_SYMBOLS=BTC,ETH,XRP
# CRYPTO_SCAN_LIMIT=5
# CRYPTO_SCAN_INTERVAL_HOURS=6
# CRYPTO_HOLDINGS_CHECK_INTERVAL_HOURS=3
# CRYPTO_MAX_POSITION_PCT=50.0
# CRYPTO_MIN_CASH_RATIO=0.20
# CRYPTO_MAX_SINGLE_ORDER_KRW=15000
# CRYPTO_MAX_DAILY_TRADES=3
# CRYPTO_MIN_BUY_QUANTITY=0.0
# CRYPTO_RECOMMENDATION_EXPIRE_MIN=60
#
# 참고:
# - 5만원 기준: 현금 20% 유지(1만원) → 실투자 4만원 → 코인당 ~1.5만원
# - MAX_SINGLE_ORDER_KRW=15000: 1회 주문 1.5만원 제한 (실수 방지)
# - MAX_POSITION_PCT=50%: 소액이므로 집중 투자 허용 (2~3 포지션)
# - 대형 코인 3종만 감시하여 스캔 비용 최소화
# - 스캔 6시간 간격: 소액은 빈번한 거래보다 신중한 진입이 유리
# - 빗썸 최소 주문 5,000원 이상이므로 너무 적은 수량 주의
# - 이 프로필은 시스템 동작 확인 후 100만원 프로필로 전환 권장
#
# === 분석만 모드 (매매 없이 AI 인사이트만 활용) ===
#
# CRYPTO_ENABLED=true
# CRYPTO_TRADING_ENABLED=false
# CRYPTO_AUTONOMY_MODE=SEMI_AUTO
# CRYPTO_WATCHLIST_SYMBOLS=BTC,ETH,XRP,SOL,ADA
# CRYPTO_SCAN_INTERVAL_HOURS=4
#
# 참고:
# - CRYPTO_TRADING_ENABLED=false: 주문 실행 없이 분석 결과만 /admin-coin에 표시
# - 빗썸 API 키 없어도 공개 시세 조회는 동작 (잔고/주문만 인증 필요)
